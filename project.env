# Project identity lives here so the CLI/package name can change later.
#
# Source this file from scripts instead of hard-coding user-facing names.
# A future rename should usually only need updates here, README text, and the
# executable filename or symlink.
ADPUTATE_DISPLAY_NAME="Adputate"
ADPUTATE_CLI_NAME="adputate"
ADPUTATE_CONTAINER_NAME="adputate-pihole"
ADPUTATE_SERVICE_LABEL="com.adputate.pihole"
