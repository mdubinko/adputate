# Nebula Sync profile for Adputate.
#
# Nebula Sync is not part of the official Pi-hole project. It is the preferred
# v6-era sync path here because it uses Pi-hole v6 APIs and Teleporter instead
# of the older Gravity Sync approach.
#
# Replace the primary URL/password with the dedicated Pi-hole, such as a NUC.
# Use the password printed by `bin/adputate password` for the local replica.

PRIMARY=http://192.168.1.2|primary-pihole-password
REPLICAS=http://127.0.0.1:8080|adputate-password

FULL_SYNC=true
RUN_GRAVITY=true

# Optional schedule for a long-running Nebula Sync container/process.
# Leave unset for one-shot sync runs.
# CRON=0 * * * *

# Useful if the primary uses self-signed HTTPS.
# CLIENT_SKIP_TLS_VERIFICATION=true
