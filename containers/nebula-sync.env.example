# Nebula Sync profile for Adputate.
#
# Nebula Sync is not part of the official Pi-hole project. It is the preferred
# v6-era sync path here because it uses Pi-hole v6 APIs and Teleporter instead
# of the older Gravity Sync approach.
#
# This is a reference profile, not a file to fill with real credentials.
# `adputate host sync now` creates a private, mode-0600 runtime file containing
# PRIMARY and REPLICAS values read from Keychain/local managed configuration,
# gives it only to the ephemeral sync container, and deletes it on exit.
PRIMARY=http://authority.example.invalid|generated-at-runtime
REPLICAS=http://replica.example.invalid|generated-at-runtime

# Selective, one-way policy sync. Host-specific DNS, web, DHCP, NTP,
# database, privacy, and blocking-state configuration stays node-local.
FULL_SYNC=false
RUN_GRAVITY=true
SYNC_GRAVITY_GROUP=true
SYNC_GRAVITY_AD_LIST=true
SYNC_GRAVITY_AD_LIST_BY_GROUP=true
SYNC_GRAVITY_DOMAIN_LIST=true
SYNC_GRAVITY_DOMAIN_LIST_BY_GROUP=true

# Clients and client-to-group mappings remain opt-in until both installations
# have been checked for compatible client identity/group semantics.
SYNC_GRAVITY_CLIENT=false
SYNC_GRAVITY_CLIENT_BY_GROUP=false

# Adputate schedules one-shot containers itself; Nebula Sync's CRON is unset.

# Certificate verification stays enabled. Install/trust the private CA rather
# than setting CLIENT_SKIP_TLS_VERIFICATION=true.
