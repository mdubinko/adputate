#!/usr/bin/env bash
set -euo pipefail

launcher="${BASH_SOURCE[0]}"
while [[ -L "$launcher" ]]; do
  launcher_dir="$(cd -- "$(dirname -- "$launcher")" && pwd)"
  launcher="$(readlink "$launcher")"
  [[ "$launcher" == /* ]] || launcher="$launcher_dir/$launcher"
done
PREFIX="$(cd -- "$(dirname -- "$launcher")/.." && pwd)"
if [[ -x "$PREFIX/libexec/adputate/adputate.sh" ]]; then
  exec "$PREFIX/libexec/adputate/adputate.sh" "$@"
fi
exec "$PREFIX/libexec/adputate.sh" "$@"
